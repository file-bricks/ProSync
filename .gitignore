# =============================================================================
# .gitignore Template fuer Software Entwicklung Projekte
# Kopieren und als .gitignore im Projektroot ablegen
# Projektspezifische Eintraege am Ende anfuegen
# =============================================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/
.pytest_cache/
.pytest_temp/
.pytest_tmp*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.turbo/
.nyc_output/
wheelhouse/
.wheel-smoke/

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- BACH Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
LOCK
LOCK.*
LOCK*.txt
LOCK.permissions.json
.automation-lock
*.lock
uv.lock
!package-lock.json
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md
SKILL.md

# ---- Persoenliche / Sensible Daten ----
_USER/
.env
.env.*
credentials.json
client_secret*.json
token.json
ProSync_config.json
*.db
*.db3
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.mdb
*.accdb
*.bak
*.lock
*.tmp
*.pem
*.key
*.pfx
*.cer
*.crt
secrets.*
LOCK.*
keyring/

# ---- Build-Artefakte & Releases ----
releases/
*.exe
*.msi
*.msix
*.appx
*.spec

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Lokale Sync-/Host-Nebenstaende & Multi-Host-Schutz ----
*-ASUS-GEI.md
*-WORKSTATION-LG.md
*-WORKSTATION-LG*
*-ASUS-GEI*
*-WORKSTATION*
*-ASUS*
*-LAPTOP*
*-Mac Studio*
*-MacBook*
*-IDEAPAD*
* (kopie)*
* (copy)*
* (Kopie)*
* (Copy)*
* (konflikt)*
* (sync-conflict)*
*.sync-conflict-*
*.sync-temp-*
*conflicted copy*
*.conflict
*.conflict-*
*-CONFLIT-*
*-conflict-*
* - Kopie.*
* - Kopie (*).*
*.orig
*.rej

# ---- Web / Node Dependencies ----
node_modules/

# ---- Planung & Interne Doku ----
PLAN.txt

# ---- Private / Archive ----
_archive/
_private/

# ---- Projektspezifisch (hier eigene Eintraege anfuegen) ----

# ---- Entwicklungs- und Backup-Ordner ----
_BACKUP/
_DEV/
_WARTUNG/
!_WARTUNG/
_WARTUNG/*
!_WARTUNG/generate_store_screenshots.py
_alt/

# ---- Logs ----
*.log
DECISIONS.md
PORTIERUNGSPLAN.md
TODO.md
DONE.md
ENTWICKLUNGSPLAN*.md
Feature_Analyse*.md

# ---- Lokale, nicht referenzierte Generator-Artefakte ----
# Die kanonisch referenzierte PWA-Datei ist web_companion/apple-touch-icon-180.png.
web_companion/_backups/
web_companion/web_companion_artifacts/
web_companion_artifacts/
web_companion/apple-touch-icon.png
web_companion/favicon.ico
web_companion/favicon.png
web_companion/icons/apple-touch-icon*.png
web_companion/icons/favicon.png
assets/android-icon-*.png
assets/splash-icon.png

# ---- Windows Store: track metadata, keep generated packages out ----
!releases/
releases/*
!releases/windowsstore/
releases/windowsstore/*
!releases/windowsstore/BUILD.md
!releases/windowsstore/WACK_PROTOCOL.md
!releases/windowsstore/store_listing_de.md
!releases/windowsstore/store_listing_en.md
!releases/windowsstore/store_settings.json
!releases/windowsstore/StoreLogo.png

search_config.json

